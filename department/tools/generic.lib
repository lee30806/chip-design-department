/* 대체 STA용 일반 셀 라이브러리. 실제 공정 값이 아니다 (지연 단위 ns). 사내 라이브러리로 바꾼다. */
library (generic_sta) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1, pf);
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  cell (INV_X1) {
    area : 1.0;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.02"); }
        cell_fall (scalar) { values ("0.02"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (BUF_X1) {
    area : 1.3;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.03"); }
        cell_fall (scalar) { values ("0.03"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (NAND2_X1) {
    area : 1.3;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!(A&B)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.03"); }
        cell_fall (scalar) { values ("0.03"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.03"); }
        cell_fall (scalar) { values ("0.03"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (NOR2_X1) {
    area : 1.3;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!(A|B)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.04"); }
        cell_fall (scalar) { values ("0.04"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.04"); }
        cell_fall (scalar) { values ("0.04"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (AND2_X1) {
    area : 1.6;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "(A&B)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (OR2_X1) {
    area : 1.6;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "(A|B)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.05"); }
        cell_fall (scalar) { values ("0.05"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.05"); }
        cell_fall (scalar) { values ("0.05"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (XOR2_X1) {
    area : 2.2;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "(A^B)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (XNOR2_X1) {
    area : 2.2;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!(A^B)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (AOI21_X1) {
    area : 1.6;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (C) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!((A&B)|C)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "C";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (OAI21_X1) {
    area : 1.6;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (C) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!((A|B)&C)";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "C";
        cell_rise (scalar) { values ("0.045"); }
        cell_fall (scalar) { values ("0.045"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (MUX2_X1) {
    area : 2.6;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (S) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "((A&!S)|(B&S))";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "B";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
      timing () {
        related_pin : "S";
        cell_rise (scalar) { values ("0.06"); }
        cell_fall (scalar) { values ("0.06"); }
        rise_transition (scalar) { values ("0.01"); }
        fall_transition (scalar) { values ("0.01"); }
      }
    }
  }
  cell (DFF_X1) {
    area : 4.5;
    ff (IQ, IQN) { next_state : "D"; clocked_on : "CK"; }
    pin (D) { direction : input; capacitance : 0.002; timing () { related_pin : "CK"; timing_type : setup_rising; rise_constraint (scalar) { values ("0.040"); } fall_constraint (scalar) { values ("0.040"); } } }
    pin (CK) { direction : input; clock : true; capacitance : 0.002; }
    pin (Q) { direction : output; function : "IQ"; timing () { related_pin : "CK"; timing_type : rising_edge; cell_rise (scalar) { values ("0.080"); } cell_fall (scalar) { values ("0.080"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } }
  }
  cell (DFFR_X1) {
    area : 5.2;
    ff (IQ, IQN) { next_state : "D"; clocked_on : "CK"; clear : "!RN"; }
    pin (D) { direction : input; capacitance : 0.002; timing () { related_pin : "CK"; timing_type : setup_rising; rise_constraint (scalar) { values ("0.040"); } fall_constraint (scalar) { values ("0.040"); } } }
    pin (CK) { direction : input; clock : true; capacitance : 0.002; }
    pin (RN) { direction : input; capacitance : 0.002; }
    pin (Q) { direction : output; function : "IQ"; timing () { related_pin : "CK"; timing_type : rising_edge; cell_rise (scalar) { values ("0.080"); } cell_fall (scalar) { values ("0.080"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } }
  }
  cell (DFFS_X1) {
    area : 5.2;
    ff (IQ, IQN) { next_state : "D"; clocked_on : "CK"; preset : "!SN"; }
    pin (D) { direction : input; capacitance : 0.002; timing () { related_pin : "CK"; timing_type : setup_rising; rise_constraint (scalar) { values ("0.040"); } fall_constraint (scalar) { values ("0.040"); } } }
    pin (CK) { direction : input; clock : true; capacitance : 0.002; }
    pin (SN) { direction : input; capacitance : 0.002; }
    pin (Q) { direction : output; function : "IQ"; timing () { related_pin : "CK"; timing_type : rising_edge; cell_rise (scalar) { values ("0.080"); } cell_fall (scalar) { values ("0.080"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } }
  }
}
