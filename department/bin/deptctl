#!/usr/bin/env python3
"""Seat의 게이트웨이 클라이언트. Seat 진입점이 준 API 키(자기 키만 읽을 수 있음)로 게이트웨이를 부른다.

    deptctl runs | status <실행> | detail <실행> | review <실행> | rtl <실행> | pending | specs | spec <SPEC>
    deptctl submit <SPEC 작업 공간 ID> [--config JSON]      (RTL Engineer, Chip-lead. 고정된 SPEC만)
    deptctl feedback <body.json>                          (Design-lead만)

승인과 반려는 사람(승인자 역할)이 게이트웨이 승인함에서 한다. Seat는 할 수 없다.
권한은 게이트웨이가 Seat 계정의 역할로 다시 검사한다. 이 도구가 역할에 없는 명령을 숨기는 것은 안내일 뿐이다.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

ROLE = os.environ.get("CHIPDEPT_SEAT_ROLE", "none")
SEAT = os.environ.get("CHIPDEPT_SEAT", "?")
GATEWAY = os.environ.get("CHIPDEPT_GATEWAY", "http://127.0.0.1:8750")
WRITE_CMDS = {"submit": {"rtl-engineer", "chip-lead"}, "feedback": {"design-lead"}}


def key() -> str:
    p = os.environ.get("CHIPDEPT_SEAT_KEY_FILE")
    try:
        return Path(p).read_text(encoding="utf-8").strip() if p else ""
    except OSError as e:
        sys.exit(f"Seat API 키를 읽을 수 없음: {e}")


def call(method: str, path: str, body=None):
    req = urllib.request.Request(GATEWAY + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json", "Authorization": f"Bearer {key()}"})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=60) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        print(json.dumps(json.loads(e.read()), ensure_ascii=False), file=sys.stderr)
        sys.exit(1)


def main() -> int:
    ap = argparse.ArgumentParser(prog="deptctl", description=f"게이트웨이 ({SEAT}, 역할 {ROLE})")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for n in ("runs", "pending", "specs", "me"):
        sub.add_parser(n)
    for n in ("status", "detail", "review", "rtl"):
        sub.add_parser(n).add_argument("run_id")
    sub.add_parser("spec").add_argument("spec_id")
    allowed = {c for c, roles in WRITE_CMDS.items() if ROLE in roles}
    if "submit" in allowed:
        s = sub.add_parser("submit")
        s.add_argument("spec_id")
        s.add_argument("--config", default="{}")
    if "feedback" in allowed:
        sub.add_parser("feedback").add_argument("body", type=Path)
    hidden = sorted(set(WRITE_CMDS) - allowed) + ["decide", "approve"]
    if len(sys.argv) > 1 and sys.argv[1] in hidden:
        msg = ("승인과 반려는 사람(승인자)이 게이트웨이 승인함에서 함" if sys.argv[1] in ("decide", "approve") else
               "수정 요구는 Design-lead에게 환류 양식으로 보냄")
        print(f"{SEAT}({ROLE})는 '{sys.argv[1]}'을(를) 쓸 수 없음. {msg}", file=sys.stderr)
        return 2
    a = ap.parse_args()
    if a.cmd in ("runs", "specs", "me"):
        out = call("GET", f"/api/{a.cmd}")
    elif a.cmd == "pending":
        out = call("GET", "/api/approvals/pending")
    elif a.cmd == "status":
        out = call("GET", f"/api/runs/{a.run_id}")
    elif a.cmd in ("detail", "rtl"):
        out = call("GET", f"/api/runs/{a.run_id}/{a.cmd}")
    elif a.cmd == "review":
        out = call("GET", f"/api/runs/{a.run_id}/detail")["review"]
    elif a.cmd == "spec":
        out = call("GET", f"/api/specs/{a.spec_id}")
    elif a.cmd == "submit":
        out = call("POST", "/api/runs", {"spec_id": a.spec_id, "config": json.loads(a.config)})
    else:
        out = call("POST", "/api/feedback", json.loads(a.body.read_text(encoding="utf-8")))
    print(json.dumps(out, ensure_ascii=False, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
