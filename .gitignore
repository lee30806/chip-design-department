.omc
__pycache__
.pytest_cache
*.swp

# P0 실험: 로컬 설정, 실행 결과, 사내 샘플은 올리지 않음
experiments/p0/agents.json
experiments/p0/results/
experiments/p0/x2_wavejson/samples/*
!experiments/p0/x2_wavejson/samples/README.md

# 예시 SPEC 원본(MIPI 등)은 재배포 조건이 있으므로 올리지 않음
experiments/specs/*
!experiments/specs/README.md
experiments/**/*.pdf
experiments/**/*.docx
experiments/**/*.doc
experiments/**/*.xlsx
experiments/**/*.xls
experiments/**/*.vsdx

# OpenRig가 rig 디렉터리에 만드는 파일
experiments/p0/x6_chat_roundtrip/rig/AGENTS.md

# Claude Code 리허설용 설정 디렉터리 (CLAUDE_CONFIG_DIR)
experiments/p0/local/claude-config/

# Pi가 실행 중에 만드는 파일 (인증 정보가 들어갈 수 있음)
experiments/p0/local/pi/*
!experiments/p0/local/pi/models.json
build/
.venv/

# cocotb가 실행할 때 남기는 결과 파일
tests/sim/*.result.xml
