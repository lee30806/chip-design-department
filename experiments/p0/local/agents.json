{
  "agents": [
    {
      "_note": "로컬 ollama 리허설. cc-*는 기본 런타임 Claude Code, pi-*는 Pi. -inline은 TASK.md 본문을 명령에 직접 넣는 방식",
      "name": "cc-qwen3.5-9b",
      "family": "Qwen",
      "runtime": "claude-code",
      "command": [
        "claude",
        "--bare",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read",
        "Write",
        "Edit",
        "Bash(python3 tools/validate_ir.py:*)",
        "--no-session-persistence"
      ],
      "model": "qwen3.5:9b",
      "env": {
        "CLAUDE_CONFIG_DIR": "{config_dir}/claude-config",
        "ANTHROPIC_BASE_URL": "http://localhost:11434",
        "ANTHROPIC_API_KEY": "local",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "32768"
      },
      "vision": false
    },
    {
      "name": "cc-gemma4-12b",
