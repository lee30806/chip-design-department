{
  "agents": [
    {
      "_note": "P0 로컬 판정용 (2026-10-11). 앱 서버와 분리한 ollama 서버를 11501 포트에 컨텍스트 65536으로 띄워 씀. 32768에서는 Claude Code가 X1 과제 중 autocompact를 반복하다 실패하고, Seat는 시작 프롬프트만으로 한도를 넘음",
      "name": "cc-qwen3.5-9b",
      "family": "Qwen",
      "runtime": "claude-code",
      "command": [
        "claude",
        "--bare",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read",
        "Write",
        "Edit",
        "Bash(python3 tools/validate_ir.py:*)",
        "--no-session-persistence"
      ],
      "model": "qwen3.5:9b",
      "env": {
        "CLAUDE_CONFIG_DIR": "{config_dir}/claude-config",
        "ANTHROPIC_BASE_URL": "http://localhost:11501",
        "ANTHROPIC_API_KEY": "local",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "65536",
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "vision": false,
      "timeout_s": 900
    },
    {
      "name": "cc-gemma4-12b",
      "family": "Gemma",
      "runtime": "claude-code",
      "command": [
        "claude",
        "--bare",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read",
        "Write",
        "Edit",
        "Bash(python3 tools/validate_ir.py:*)",
        "--no-session-persistence"
      ],
      "model": "gemma4:12b",
      "env": {
        "CLAUDE_CONFIG_DIR": "{config_dir}/claude-config",
        "ANTHROPIC_BASE_URL": "http://localhost:11501",
        "ANTHROPIC_API_KEY": "local",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "65536",
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "vision": false,
      "timeout_s": 900
    },
    {
      "_note": "로컬 ollama 리허설. cc-*는 기본 런타임 Claude Code, pi-*는 Pi. -inline은 TASK.md 본문을 명령에 직접 넣는 방식",
      "name": "cc-qwen3-vl-8b",
      "family": "Qwen",
      "runtime": "claude-code",
      "command": [
        "claude",
        "--bare",
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read",
        "Write",
        "Edit",
        "--no-session-persistence"
      ],
      "model": "qwen3-vl:8b",
      "env": {
        "CLAUDE_CONFIG_DIR": "{config_dir}/claude-config",
        "ANTHROPIC_BASE_URL": "http://localhost:11501",
        "ANTHROPIC_API_KEY": "local",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "65536",
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "vision": true,
      "timeout_s": 900
    },
    {
      "name": "pi-qwen3-vl-8b-inline",
      "family": "Qwen",
      "runtime": "pi",
      "command": [
        "pi",
        "-p",
        "--no-session",
        "--offline",
        "--no-context-files",
        "--no-extensions",
        "--no-skills",
        "--no-prompt-templates",
        "--model",
        "ollama/{model}",
        "@{image}",
        "{task}"
      ],
      "model": "qwen3-vl:8b",
      "env": {
        "PI_CODING_AGENT_DIR": "{config_dir}/pi-judge"
      },
      "vision": true,
      "timeout_s": 900
    }
  ]
}
